# ---- Public (embedded in the browser bundle: addresses and URLs only) ----
# Vault (0x...) printed by relayer/scripts/deploy_evm.mjs --send, and the block it was deployed in
VITE_VAULT_ADDRESS=
VITE_VAULT_DEPLOY_BLOCK=0
# GenLayer solver (0x...) printed by relayer/scripts/deploy_genlayer.mjs
VITE_GENLAYER_CONTRACT=
VITE_PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
# Always-on relayer API (Mode B). LEAVE EMPTY on Vercel to use the serverless relayer in api/ (Mode A).
# In `vite dev`, empty defaults to http://localhost:8788.
VITE_RELAYER_API=

# ---- Server-only (Vercel env, NEVER prefixed VITE_; needed for the serverless relayer in api/) ----
# RELAYER_PRIVATE_KEY=0x...
# GENLAYER_PRIVATE_KEY=0x...
# GENLAYER_CONTRACT_ADDRESS=0x...
# GENLAYER_CHAIN=studionet
