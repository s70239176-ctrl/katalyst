# ---- Public (embedded in the browser bundle: addresses and URLs only) ----
# Vault (0x...) printed by relayer/scripts/deploy_evm.mjs --send, and the block it was deployed in
VITE_VAULT_ADDRESS=
VITE_VAULT_DEPLOY_BLOCK=0
# GenLayer solver (0x...) printed by relayer/scripts/deploy_genlayer.mjs
VITE_GENLAYER_CONTRACT=
VITE_PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
# Optional: several settlement chains (shows a chain picker). JSON array; see docs/INTEGRATION.md. Quote the value.
# v2 vault (first entry is the default); keep the v1 entry if you want it selectable:
# VITE_CHAINS='[{"key":"portaldot-v2","name":"Portaldot V3 Testnet","chainId":420420777,"rpcUrl":"https://test-evm-rpc-v3.portaldot.dev","vault":"0x786DEF20A47b7B22c67eBaac3A9a3b3D5C0ddD46","hub":"0xE987E541075b404c2376c9d94A517A2A9Af0997E","version":2,"deployBlock":136286,"symbol":"tPOT","portaldotNative":true,"legacyNonceRefs":false,"explorerBlockUrl":"https://node-console.portaldot.dev/#/explorer/query/{block}"}]'
# Earlier solver deployments (comma separated), so intents adjudicated by them still verify.
VITE_GENLAYER_FALLBACKS=
# Always-on relayer API (Mode B). LEAVE EMPTY on Vercel to use the serverless relayer in api/ (Mode A).
# In `vite dev`, empty defaults to http://localhost:8788.
VITE_RELAYER_API=

# ---- Server-only (Vercel env, NEVER prefixed VITE_; needed for the serverless relayer in api/) ----
# RELAYER_PRIVATE_KEY=0x...
# GENLAYER_PRIVATE_KEY=0x...
# GENLAYER_CONTRACT_ADDRESS=0x...
# GENLAYER_CHAIN=studionet
# VAULTS='[{"key":"portaldot-v2","name":"Portaldot V3 Testnet","chainId":420420777,"rpcUrl":"...","vault":"0x786DEF20A47b7B22c67eBaac3A9a3b3D5C0ddD46","version":2,"deployBlock":136286}]'   # must match VITE_CHAINS keys
# NOTIFY_WEBHOOK_URL=   TELEGRAM_BOT_TOKEN=   TELEGRAM_CHAT_ID=   (optional operator notifications)
