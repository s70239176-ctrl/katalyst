{
  "name": "katalyst-relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "compile:evm": "node scripts/compile_evm.mjs",
    "test:evm": "node scripts/test_evm.mjs",
    "estimate:evm": "node scripts/deploy_evm.mjs",
    "deploy:evm": "node scripts/deploy_evm.mjs --send",
    "fund:info": "node scripts/fund_evm.mjs",
    "fuzz:evm": "node scripts/fuzz_evm.mjs",
    "test:solver": "python -m unittest discover -s ../genlayer/tests -v"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "ethers": "^6.17.0",
    "genlayer-js": "^1.1.8"
  },
  "devDependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/api-contract": "^17.0.2",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@types/node": "^26.6.5",
    "ganache": "^7.9.2",
    "solc": "^0.8.37",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
