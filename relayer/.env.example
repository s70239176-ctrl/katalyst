# --- Portaldot V3 testnet (EVM RPC / pallet-revive) ---
PORTALDOT_EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
# Native (Substrate) endpoint, used only by scripts/fund_evm.mjs and scripts/estimate_deposit.mjs
PORTALDOT_WS=wss://test-node-v3.portaldot.dev

# Deployed KatalystVault (0x...). scripts/deploy_evm.mjs --send prints it.
VAULT_CONTRACT_ADDRESS=
# Optional: first block to scan for IntentDeposited (default: head - PORTALDOT_BACKFILL_BLOCKS)
VAULT_START_BLOCK=
# Optional explorer base URL; blocks are linked as <base>/#/explorer/query/<blockNumber>
PORTALDOT_EXPLORER_URL=https://node-console.portaldot.dev

# EVM keys. Fund each key's *mapped native account* (see `node scripts/fund_evm.mjs`).
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Comma-separated H160 pool addresses whitelisted at deploy time
SEED_POOLS=

# --- GenLayer ---
# studionet (default, gasless) | testnetAsimov | testnetBradbury | localnet. RPC URL empty = chain default.
GENLAYER_CHAIN=studionet
GENLAYER_RPC_URL=
# Deployed IntelligentVaultSolver address (0x...)
GENLAYER_CONTRACT_ADDRESS=
# Hex private key of the GenLayer account that submits adjudication transactions
GENLAYER_PRIVATE_KEY=
GENLAYER_POLL_INTERVAL_MS=6000
GENLAYER_MAX_POLLS=200

# Forward the storage-deposit refund the chain pays the relayer back to the depositor
RELAYER_RETURN_REFUND=true
RELAYER_MAX_REFUND_RETURN_TPOT=50

# Read-only verdict/health API consumed by the dApp
RELAYER_API_PORT=8788
RELAYER_DATA_DIR=data
GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com
